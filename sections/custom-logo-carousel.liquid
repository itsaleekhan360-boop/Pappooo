{%- style -%}
.logo-bar--{{ section.id }} {
  opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
}
{%- endstyle -%}

{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div class="page-width {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }} {% endif %}">
  {%- if section.settings.title != blank -%}
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="carousel carousel--{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="">
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {%- render 'image-element',
              img: block.settings.image,
              widths: '180, 360, 540, 720',
              classes: 'carousel__image',
              sizeVariable: '160px',
              fallback: '110px',
            -%}
          {%- else -%}
            {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script> 

// on window load
window.addEventListener('load', function() {
  // init logo carousel using flickity
    var elem = document.querySelector('.carousel--{{ section.id }}');
    console.log(elem)
    var flkty = new Flickity( elem, {
      cellAlign: 'center',
      contain: true,
      wrapAround: true,
      autoPlay: 2000,
      prevNextButtons: true,
      pageDots: true
    });

    // pause carousel on hover
    elem.addEventListener('mouseenter', function() {
      flkty.pausePlayer();
    });

    // resume carousel on mouse leave

    elem.addEventListener('mouseleave', function() {
      flkty.unpausePlayer();
    });

    // pause carousel on touch

    elem.addEventListener('touchstart', function() {
      flkty.pausePlayer();
    });

    // resume carousel on touch end

    elem.addEventListener('touchend', function() {
      flkty.unpausePlayer();
    });

    // resume carousel on touch cancel

    elem.addEventListener('touchcancel', function() {
      flkty.unpausePlayer();
    });

    // resume carousel on touch leave

    elem.addEventListener('touchleave', function() {
      flkty.unpausePlayer();
    });

});

</script>

{%- if section.settings.divider -%}</div>{%- endif -%}

{% schema %}
{
  "name": "Custom Logo Carousel",
  "class": "index-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.logo-list.settings.title.label"
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "t:sections.logo-list.settings.logo_opacity.label",
      "default": 76,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.logo-list.settings.divider.label",
      "default": false
    },
    {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
    }
  ],
  "blocks": [
    {
      "type": "logo_image",
      "name": "t:sections.logo-list.blocks.logo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.logo-list.blocks.logo.settings.image.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.logo-list.blocks.logo.settings.link.label",
          "info": "t:sections.logo-list.blocks.logo.settings.link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Logo Carousel",
      "blocks": [
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
