{%- style -%}
  .sub-banner-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 350px;
    font-family: 'Core Rhino', sans-serif;
  }

  /* Ab content page-width class ke andar rahega */
  .sub-banner-{{ section.id }} .page-width {
    width: 100%;
  }

  .sub-banner-container {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .sub-banner-content {
    max-width: 650px;
    text-align: left;
  }

  .sub-banner-heading {
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.15;
    color: {{ section.settings.text_color }};
    margin: 0 0 18px 0;
    letter-spacing: -0.5px;
  }

  .sub-banner-text {
    font-size: {{ section.settings.subtext_size_desktop }}px;
    font-weight: {{ section.settings.subtext_weight }};
    line-height: 1.5;
    color: {{ section.settings.text_color }};
    opacity: 0.85;
    margin: 0 0 28px 0;
  }

  .sub-banner-btn {
    display: inline-block;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    padding: 14px 35px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  .sub-banner-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 768px) {
    .sub-banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }

    .sub-banner-content {
      text-align: center;
      max-width: 100%;
    }

    .sub-banner-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .sub-banner-text {
      font-size: {{ section.settings.subtext_size_mobile }}px;
    }
    
    /* Mobile par content center karne ke liye */
    .sub-banner-container {
      justify-content: center;
    }
  }
{%- endstyle -%}

<section class="sub-banner-{{ section.id }}">
  <div class="page-width">
    <div class="sub-banner-container">
      
      <div class="sub-banner-content">
        <h2 class="sub-banner-heading">{{ section.settings.heading | newline_to_br }}</h2>
        <div class="sub-banner-text">{{ section.settings.subtext }}</div>
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link }}" class="sub-banner-btn">
            {{ section.settings.btn_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Subscription Banner",
  "settings": [
    { "type": "header", "content": "Section Layout Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 5, "unit": "px", "label": "Padding Top", "default": 120 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 5, "unit": "px", "label": "Padding Bottom", "default": 120 },
    { "type": "header", "content": "Content Settings" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Never Run Out.\nAlways Save." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Set up a subscription and have Sprout delivered when you need it. Skip, pause or cancel anytime." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Start My Subscription" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "header", "content": "Typography Settings" },
    { "type": "range", "id": "heading_size_desktop", "min": 24, "max": 72, "step": 2, "unit": "px", "label": "Heading Size (Desktop)", "default": 46 },
    { "type": "range", "id": "heading_size_mobile", "min": 18, "max": 48, "step": 2, "unit": "px", "label": "Heading Size (Mobile)", "default": 34 },
    { "type": "select", "id": "heading_weight", "label": "Heading Font Weight", "options": [ { "value": "400", "label": "Normal (400)" }, { "value": "500", "label": "Medium (500)" }, { "value": "600", "label": "Semi-Bold (600)" }, { "value": "700", "label": "Bold (700)" }, { "value": "800", "label": "Extra Bold (800)" } ], "default": "800" },
    { "type": "range", "id": "subtext_size_desktop", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "Subtext Size (Desktop)", "default": 16 },
    { "type": "range", "id": "subtext_size_mobile", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Subtext Size (Mobile)", "default": 15 },
    { "type": "select", "id": "subtext_weight", "label": "Subtext Font Weight", "options": [ { "value": "300", "label": "Light (300)" }, { "value": "400", "label": "Normal (400)" }, { "value": "500", "label": "Medium (500)" }, { "value": "600", "label": "Semi-Bold (600)" } ], "default": "400" },
    { "type": "header", "content": "Color Settings" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#d8b4e2" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#000000" },
    { "type": "color", "id": "btn_bg_color", "label": "Button Background Color", "default": "#9cd3c3" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Subscription Banner" } ]
}
{% endschema %}