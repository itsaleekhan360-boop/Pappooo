{% comment %}
  Sprout Organic US Landing Page - Why Choose Sprout Section
  File Path: Sections / us-why-sprout.liquid
{% endcomment %}

<div class="why-sprout-section-{{ section.id }} why-sprout-wrapper">
  <div class="why-sprout-container">
    
    <div class="why-sprout-header">
      {% if section.settings.sub_title != blank %}
        <span class="why-sprout-subtag">{{ section.settings.sub_title | escape }}</span>
      {% endif %}
      
      {% if section.settings.main_heading != blank %}
        <h2 class="why-sprout-title">{{ section.settings.main_heading | escape }}</h2>
      {% endif %}
    </div>

    <div class="why-sprout-grid">
      
      <!-- Card 01 -->
      <div class="why-sprout-card">
        {% if section.settings.card_1_num != blank %}
          <div class="why-card-number">{{ section.settings.card_1_num | escape }}</div>
        {% endif %}
        {% if section.settings.card_1_title != blank %}
          <h3 class="why-card-title">{{ section.settings.card_1_title | escape }}</h3>
        {% endif %}
        {% if section.settings.card_1_text != blank %}
          <p class="why-card-desc">{{ section.settings.card_1_text | escape }}</p>
        {% endif %}
      </div>

      <!-- Card 02 -->
      <div class="why-sprout-card">
        {% if section.settings.card_2_num != blank %}
          <div class="why-card-number">{{ section.settings.card_2_num | escape }}</div>
        {% endif %}
        {% if section.settings.card_2_title != blank %}
          <h3 class="why-card-title">{{ section.settings.card_2_title | escape }}</h3>
        {% endif %}
        {% if section.settings.card_2_text != blank %}
          <p class="why-card-desc">{{ section.settings.card_2_text | escape }}</p>
        {% endif %}
      </div>

      <!-- Card 03 -->
      <div class="why-sprout-card">
        {% if section.settings.card_3_num != blank %}
          <div class="why-card-number">{{ section.settings.card_3_num | escape }}</div>
        {% endif %}
        {% if section.settings.card_3_title != blank %}
          <h3 class="why-card-title">{{ section.settings.card_3_title | escape }}</h3>
        {% endif %}
        {% if section.settings.card_3_text != blank %}
          <p class="why-card-desc">{{ section.settings.card_3_text | escape }}</p>
        {% endif %}
      </div>

    </div>
  </div>
</div>

<style>
  /* Dynamic fonts registration matching Sprout branding */
  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap');

  .why-sprout-section-{{ section.id }} {
    width: 100%;
    box-sizing: border-box;
    background-color: {{ section.settings.bg_color }};
    
    /* Dynamic Spacing values set from Customizer */
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
  }

  .why-sprout-container {
    max-width: {{ section.settings.max_container_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  .why-sprout-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .why-sprout-subtag {
    font-family: 'Outfit', sans-serif;
    font-size: {{ section.settings.subtag_font_size }}px;
    font-weight: 700;
    color: {{ section.settings.accent_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 12px;
  }

  .why-sprout-title {
    font-family: 'Fredoka', sans-serif;
    font-size: {{ section.settings.title_font_size_desktop }}px;
    font-weight: 700;
    color: {{ section.settings.text_color_main }};
    margin: 0;
    letter-spacing: -0.01em;
  }

  .why-sprout-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
  }

  .why-sprout-card {
    background-color: {{ section.settings.card_bg_color }};
    border-radius: 16px;
    padding: 40px 32px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid transparent;
  }

  .why-sprout-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.03);
    border-color: rgba(121, 173, 156, 0.15);
  }

  .why-card-number {
    font-family: 'Fredoka', sans-serif;
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    color: {{ section.settings.number_color }};
    opacity: 0.75;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .why-card-title {
    font-family: 'Fredoka', sans-serif;
    font-size: {{ section.settings.card_title_font_size }}px;
    font-weight: 600;
    color: {{ section.settings.text_color_main }};
    margin: 0 0 14px 0;
    line-height: 1.3;
  }

  .why-card-desc {
    font-family: 'Outfit', sans-serif;
    font-size: {{ section.settings.card_desc_font_size }}px;
    font-weight: 400;
    line-height: 1.6;
    color: {{ section.settings.text_color_body }};
    margin: 0;
  }

  @media (max-width: 991px) {
    .why-sprout-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .why-sprout-title {
      font-size: calc({{ section.settings.title_font_size_desktop }}px * 0.85);
    }
  }

  @media (max-width: 767px) {
    .why-sprout-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: {{ section.settings.padding_left_mobile }}px;
      padding-right: {{ section.settings.padding_right_mobile }}px;
    }

    .why-sprout-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .why-sprout-header {
      margin-bottom: 32px;
    }

    .why-sprout-title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }

    .why-sprout-card {
      padding: 30px 24px;
    }

    .why-card-number {
      font-size: 54px;
      margin-bottom: 16px;
    }

    .why-card-title {
      font-size: calc({{ section.settings.card_title_font_size }}px * 0.9);
      margin-bottom: 10px;
    }

    .why-card-desc {
      font-size: calc({{ section.settings.card_desc_font_size }}px * 0.95);
    }
  }
</style>

{% schema %}
