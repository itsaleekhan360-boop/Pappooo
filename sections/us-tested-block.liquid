{% comment %}
  Sprout Organic US Landing Page - Tested Block Section
  File Path: Sections / us-tested-block.liquid
{% endcomment %}

<div class="us-tested-section-{{ section.id }} us-tested-wrapper">
  <div class="us-tested-container">

    <div class="us-tested-header">
      {% if section.settings.heading != blank %}
        <h2 class="us-tested-title">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="us-tested-subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>

    <div class="us-tested-grid">
      {% for block in section.blocks %}
        <div class="us-tested-card" {{ block.shopify_attributes }}>
          <div class="us-tested-pass-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 6L9 17L4 12" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>{{ block.settings.status | default: 'PASS' | upcase | escape }}</span>
          </div>
          {% if block.settings.title != blank %}
            <h3 class="us-tested-card-title">{{ block.settings.title | escape }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="us-tested-card-desc">{{ block.settings.description | escape }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap');

  .us-tested-section-{{ section.id }} {
    width: 100%;
    box-sizing: border-box;
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .us-tested-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .us-tested-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .us-tested-title {
    font-family: 'Fredoka', sans-serif;
    font-size: 38px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin: 0 0 14px 0;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .us-tested-subheading {
    font-family: 'Outfit', sans-serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.75;
    max-width: 640px;
    margin: 0 auto;
  }

  .us-tested-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    width: 100%;
  }

  .us-tested-card {
    background-color: {{ section.settings.card_bg_color }};
    border-radius: 16px;
    padding: 32px 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(155, 204, 199, 0.2);
  }

  .us-tested-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(28, 43, 36, 0.07);
  }

  .us-tested-pass-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: {{ section.settings.accent_color }};
    color: #ffffff;
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 50px;
    margin-bottom: 20px;
  }

  .us-tested-pass-badge svg {
    flex-shrink: 0;
  }

  .us-tested-card-title {
    font-family: 'Fredoka', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    margin: 0 0 10px 0;
    line-height: 1.3;
  }

  .us-tested-card-desc {
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  @media (max-width: 991px) {
    .us-tested-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .us-tested-title {
      font-size: 30px;
    }
  }

  @media (max-width: 768px) {
    .us-tested-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px;
    }

    .us-tested-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .us-tested-header {
      margin-bottom: 32px;
    }

    .us-tested-title {
      font-size: 26px;
    }

    .us-tested-subheading {
      font-size: 15px;
    }

    .us-tested-card {
      padding: 24px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Tested Block (US)",
  "class": "shopify-section-us-tested",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tested. And Tested Again"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Every batch independently tested to the highest standards in the world."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#f5f9f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1c2b24"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "PASS Badge / Accent Color",
      "default": "#9bccc7"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "test_item",
      "name": "Test Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Test Name",
          "default": "Microbiological Safety"
        },
        {
          "type": "text",
          "id": "status",
          "label": "Status Badge",
          "default": "PASS"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "All pathogen and contamination tests clear."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tested Block (US)",
      "category": "Trust & Safety",
      "blocks": [
        {
          "type": "test_item",
          "settings": {
            "title": "Microbiological Safety",
            "status": "PASS",
            "description": "All pathogen and contamination tests clear."
          }
        },
        {
          "type": "test_item",
          "settings": {
            "title": "Heavy Metals",
            "status": "PASS",
            "description": "Below detectable limits for arsenic, lead, cadmium, and mercury."
          }
        },
        {
          "type": "test_item",
          "settings": {
            "title": "Pesticide Residues",
            "status": "PASS",
            "description": "Zero residues detected across all certified organic ingredients."
          }
        },
        {
          "type": "test_item",
          "settings": {
            "title": "Nutritional Compliance",
            "status": "PASS",
            "description": "Independently verified against FSANZ standards for infant nutrition."
          }
        }
      ]
    }
  ]
}
{% endschema %}
