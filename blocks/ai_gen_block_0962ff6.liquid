{% doc %}
  @prompt
    An image with text section that is 50% desktop width. The text section to include: heading (Poppins Bold, #535353, text size 22), below caption label i.e. Origin (Poppins Regular, #535353, text size 12), below caption value i.e. Himalayas (Poppins Bold, #D59ED7, text size 16), below another caption label i.e. Manufcatures (Poppins Regular, #535353, text size 12), below caption value i.e. Himalayas (Poppins Bold, #D59ED7, text size 16) and below body text. Also add control of top and bottom padding., Make the section 50% desktop width
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-image-text-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-image-text-image-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
  }

  .ai-image-text-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-image-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  .ai-image-text-content-{{ ai_gen_id }} {
    flex: 0 0 50%;
    width: 50%;
  }

  .ai-image-text-heading-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: #535353;
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 20px 0;
    line-height: 1.3;
  }

  .ai-image-text-caption-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-image-text-caption-label-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    color: #535353;
    font-size: {{ block.settings.caption_label_size }}px;
    margin: 0 0 5px 0;
  }

  .ai-image-text-caption-value-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: #D59ED7;
    font-size: {{ block.settings.caption_value_size }}px;
    margin: 0;
  }

  .ai-image-text-body-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    color: #535353;
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 30px;
      width: 100%;
    }

    .ai-image-text-image-{{ ai_gen_id }},
    .ai-image-text-content-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
    }
  }
{% endstyle %}

<image-text-block-{{ ai_gen_id }}
  class="ai-image-text-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-text-wrapper-{{ ai_gen_id }}">
    <div class="ai-image-text-image-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-image-text-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-text-empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-image-text-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-image-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.caption_1_label != blank or block.settings.caption_1_value != blank %}
        <div class="ai-image-text-caption-{{ ai_gen_id }}">
          {% if block.settings.caption_1_label != blank %}
            <p class="ai-image-text-caption-label-{{ ai_gen_id }}">{{ block.settings.caption_1_label }}</p>
          {% endif %}
          {% if block.settings.caption_1_value != blank %}
            <p class="ai-image-text-caption-value-{{ ai_gen_id }}">{{ block.settings.caption_1_value }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.caption_2_label != blank or block.settings.caption_2_value != blank %}
        <div class="ai-image-text-caption-{{ ai_gen_id }}">
          {% if block.settings.caption_2_label != blank %}
            <p class="ai-image-text-caption-label-{{ ai_gen_id }}">{{ block.settings.caption_2_label }}</p>
          {% endif %}
          {% if block.settings.caption_2_value != blank %}
            <p class="ai-image-text-caption-value-{{ ai_gen_id }}">{{ block.settings.caption_2_value }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-image-text-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
      {% endif %}
    </div>
  </div>
</image-text-block-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageTextBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('image-text-block-{{ ai_gen_id }}', ImageTextBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image with text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Caption 1"
    },
    {
      "type": "text",
      "id": "caption_1_label",
      "label": "Label",
      "default": "Origin"
    },
    {
      "type": "text",
      "id": "caption_1_value",
      "label": "Value",
      "default": "Himalayas"
    },
    {
      "type": "header",
      "content": "Caption 2"
    },
    {
      "type": "text",
      "id": "caption_2_label",
      "label": "Label",
      "default": "Manufacturers"
    },
    {
      "type": "text",
      "id": "caption_2_value",
      "label": "Value",
      "default": "Himalayas"
    },
    {
      "type": "range",
      "id": "caption_label_size",
      "label": "Caption label size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "caption_value_size",
      "label": "Caption value size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Add your body text here to provide additional details about your product or service.</p>"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
