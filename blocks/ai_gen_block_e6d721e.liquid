{% doc %}
  @prompt
    i need a section that includes 4 rectangular block elements, colour EBF5F4, all edges rounded 10px radius, in total they would also take 50% of the page on desktop and it would be 2 blocks per each row. they would stack on mobile. each block to be divided into 2 columns, on the left to include the icon https://cdn.shopify.com/s/files/1/0505/7717/8797/files/icon_tick.svg and on the right text with a heading 16px poppins bold and smaller copy underneath. 10 px padding around the icon and 10px padding around the text component., please add margin on mobile, not full width 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-blocks-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-feature-blocks-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-feature-block-{{ ai_gen_id }} {
    background-color: {{ block.settings.block_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    display: flex;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    padding: {{ block.settings.block_padding }}px;
  }

  .ai-feature-block-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    padding: {{ block.settings.icon_padding }}px;
  }

  .ai-feature-block-icon-{{ ai_gen_id }} img {
    display: block;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-feature-block-content-{{ ai_gen_id }} {
    flex-grow: 1;
    padding: {{ block.settings.text_padding }}px;
  }

  .ai-feature-block-heading-{{ ai_gen_id }} {
    font-family: 'Poppins', sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
  }

  .ai-feature-block-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-blocks-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      width: calc(100% - {{ block.settings.mobile_margin }}px * 2);
      margin: 0 {{ block.settings.mobile_margin }}px;
    }
  }
{% endstyle %}

<feature-blocks-{{ ai_gen_id }} class="ai-feature-blocks-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-blocks-container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign heading_key = 'block_' | append: i | append: '_heading'
        assign text_key = 'block_' | append: i | append: '_text'
        assign heading = block.settings[heading_key]
        assign text = block.settings[text_key]
      %}
      <div class="ai-feature-block-{{ ai_gen_id }}">
        <div class="ai-feature-block-icon-{{ ai_gen_id }}">
          <img 
            src="{{ block.settings.icon_url }}" 
            alt="Feature icon"
            loading="lazy"
            width="{{ block.settings.icon_size }}"
            height="{{ block.settings.icon_size }}"
          >
        </div>
        <div class="ai-feature-block-content-{{ ai_gen_id }}">
          {% if heading != blank %}
            <h3 class="ai-feature-block-heading-{{ ai_gen_id }}">{{ heading }}</h3>
          {% endif %}
          {% if text != blank %}
            <p class="ai-feature-block-text-{{ ai_gen_id }}">{{ text }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</feature-blocks-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureBlocks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('feature-blocks-{{ ai_gen_id }}', FeatureBlocks{{ ai_gen_id }});
  })();
</script>

