<style>
  #tc-lang-switch {
    position: fixed;
    bottom: 16px;
    right: 16px;
    z-index: 99999;
    background: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 24px;
    padding: 6px 10px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    user-select: none;
  }
  #tc-lang-switch select {
    border: 0;
    background: transparent;
    font-size: 13px;
    cursor: pointer;
    padding: 4px 6px;
    appearance: none;
    -webkit-appearance: none;
  }
  #tc-lang-switch::before {
    content: "\1F310";
    margin-right: 6px;
    color: #9bccc7;
  }
  #tc-lang-switch select:focus { outline: 0; }
  html[dir="rtl"] #tc-lang-switch { right: auto; left: 16px; }
  @media (max-width: 480px) {
    #tc-lang-switch { bottom: 12px; right: 12px; padding: 4px 8px; }
    #tc-lang-switch select { font-size: 12px; }
  }
</style>

<div id="tc-lang-switch" aria-label="Language">
  <select id="tc-lang-select" aria-label="Select language">
    <option value="en">English</option>
    <option value="zh-CN">简体中文</option>
    <option value="zh-TW">繁體中文</option>
    <option value="vi">Tiếng Việt</option>
    <option value="ja">日本語</option>
    <option value="ko">한국어</option>
    <option value="ar">العربية</option>
    <option value="fr">Français</option>
  </select>
</div>

<script>
(function() {
  'use strict';

  var cfg = JSON.parse(document.getElementById('i18n-overlay-config').textContent);
  var supported = cfg.supported || ['en'];
  var rtl = cfg.rtl || [];
  var countryToLocale = cfg.countryToLocale || {};

  function fromBrowser() {
    var nav = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
    if (nav.indexOf('zh-cn') === 0 || nav.indexOf('zh-hans') === 0 || nav === 'zh') return 'zh-CN';
    if (nav.indexOf('zh-tw') === 0 || nav.indexOf('zh-hk') === 0 || nav.indexOf('zh-hant') === 0 || nav.indexOf('zh-mo') === 0) return 'zh-TW';
    if (nav.indexOf('vi') === 0) return 'vi';
    if (nav.indexOf('ja') === 0) return 'ja';
    if (nav.indexOf('ko') === 0) return 'ko';
    if (nav.indexOf('ar') === 0) return 'ar';
    if (nav.indexOf('fr') === 0) return 'fr';
    return null;
  }

  // Detect country from the Shopify Markets URL prefix. When Shopify Markets is
  // configured, paths look like /en-vn/pages/... or /zh-cn/pages/... — the second
  // segment is the country. This is more reliable than IP-based geolocation
  // because Shopify uses the resolved market, not raw IP guessing.
  function fromShopifyMarketsURL() {
    var path = window.location.pathname || '';
    var m = path.match(/^\/[a-z]{2}-([a-z]{2})\//);
    if (!m) return null;
    var country = m[1].toUpperCase();
    var loc = countryToLocale[country];
    return (loc && supported.indexOf(loc) !== -1) ? loc : null;
  }

  // Detect language from system timezone. Hard to spoof — usually reflects the
  // visitor's actual physical location. Useful when IP geo is wrong (consumer
  // VPNs often route through different countries than they advertise).
  function fromTimezone() {
    try {
      var tz = '';
      if (window.Intl && Intl.DateTimeFormat) {
        tz = (Intl.DateTimeFormat().resolvedOptions().timeZone || '').toLowerCase();
      }
      if (!tz) return null;
      if (tz.indexOf('asia/ho_chi_minh') !== -1 || tz.indexOf('asia/saigon') !== -1) return 'vi';
      if (tz.indexOf('asia/shanghai') !== -1 || tz.indexOf('asia/chongqing') !== -1 ||
          tz.indexOf('asia/urumqi') !== -1 || tz.indexOf('asia/harbin') !== -1 ||
          tz === 'asia/singapore') return 'zh-CN';
      if (tz.indexOf('asia/hong_kong') !== -1 || tz.indexOf('asia/taipei') !== -1 ||
          tz.indexOf('asia/macau') !== -1) return 'zh-TW';
      if (tz.indexOf('asia/tokyo') !== -1) return 'ja';
      if (tz.indexOf('asia/seoul') !== -1 || tz.indexOf('asia/pyongyang') !== -1) return 'ko';
      if (tz.indexOf('asia/riyadh') !== -1 || tz.indexOf('asia/baghdad') !== -1 ||
          tz.indexOf('asia/dubai') !== -1 || tz.indexOf('asia/qatar') !== -1 ||
          tz.indexOf('asia/kuwait') !== -1 || tz.indexOf('asia/bahrain') !== -1 ||
          tz.indexOf('asia/muscat') !== -1 || tz.indexOf('asia/amman') !== -1 ||
          tz.indexOf('asia/beirut') !== -1 || tz.indexOf('asia/damascus') !== -1 ||
          tz.indexOf('africa/cairo') !== -1 || tz.indexOf('africa/casablanca') !== -1 ||
          tz.indexOf('africa/algiers') !== -1 || tz.indexOf('africa/tunis') !== -1 ||
          tz.indexOf('africa/tripoli') !== -1 || tz.indexOf('africa/khartoum') !== -1) return 'ar';
    } catch (e) {}
    return null;
  }

  // Synchronous detection priority:
  // 1. URL ?lang=     — temporary, doesn't persist
  // 2. localStorage   — only set by the manual language switcher
  // 3. Shopify Markets URL prefix (/en-vn/...) — strong country signal
  // 4. Browser language
  // 5. Default
  function detectLocaleSync() {
    try {
      var url = new URL(window.location.href);
      var fromUrl = url.searchParams.get('lang');
      if (fromUrl && supported.indexOf(fromUrl) !== -1) {
        // URL ?lang= is a temporary override for this page load only.
        // Don't persist — only the manual switcher writes to localStorage.
        return fromUrl;
      }
    } catch (e) {}
    try {
      var stored = localStorage.getItem('tc_lang_v2');
      if (stored && supported.indexOf(stored) !== -1) return stored;
    } catch (e) {}
    var fromMarkets = fromShopifyMarketsURL();
    if (fromMarkets) return fromMarkets;
    var fromNav = fromBrowser();
    if (fromNav && supported.indexOf(fromNav) !== -1) return fromNav;
    var fromTz = fromTimezone();
    if (fromTz && supported.indexOf(fromTz) !== -1) return fromTz;
    return cfg['default'] || 'en';
  }

  // Async IP-based geolocation. Always fetches fresh so VPN / network changes
  // are detected. Cache is only used as a fallback if the fetch fails.
  function detectLocaleByIP() {
    return new Promise(function(resolve) {
      function fallbackToCache() {
        try {
          var cached = JSON.parse(localStorage.getItem('tc_geo_v2') || 'null');
          if (cached && cached.country) {
            var loc = countryToLocale[cached.country];
            if (loc && supported.indexOf(loc) !== -1) return resolve(loc);
          }
        } catch (e) {}
        resolve(null);
      }

      if (!window.fetch) return fallbackToCache();

      var ctrl = ('AbortController' in window) ? new AbortController() : null;
      if (ctrl) setTimeout(function(){ try { ctrl.abort(); } catch(e){} }, 4000);

      fetch('https://api.country.is/', ctrl ? { signal: ctrl.signal } : {})
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(data) {
          if (!data || !data.country) return fallbackToCache();
          try { localStorage.setItem('tc_geo_v2', JSON.stringify({ country: data.country, t: Date.now() })); } catch (e) {}
          var loc = countryToLocale[data.country];
          if (loc && supported.indexOf(loc) !== -1) return resolve(loc);
          resolve(null);
        })
        .catch(fallbackToCache);
    });
  }

  function applyDir(locale) {
    var dir = rtl.indexOf(locale) !== -1 ? 'rtl' : 'ltr';
    document.documentElement.setAttribute('dir', dir);
    document.documentElement.setAttribute('lang', locale);
  }

  function norm(s) {
    // Normalise smart quotes / non-breaking spaces so dictionary keys
    // (written with straight quotes) match DOM text that uses typographic chars.
    return (s || '')
      .replace(/[‘’]/g, "'")     // ' '  →  '
      .replace(/[“”]/g, '"')     // " "  →  "
      .replace(/ /g, ' ')             // nbsp →  space
      .replace(/\s+/g, ' ')
      .trim();
  }

  function buildPasses(bag) {
    var TEXT = bag._text || {};
    var HTML = bag._html || {};

    function translateHTML(root) {
      if (!root.querySelectorAll) return;
      var els = root.querySelectorAll('p, h1, h2, h3, h4, h5, h6, li, blockquote, button, a, span, div');
      for (var i = 0; i < els.length; i++) {
        var el = els[i];
        if (el.dataset && el.dataset.i18nDone === '1') continue;
        var key = norm(el.innerHTML);
        if (HTML[key]) {
          el.innerHTML = HTML[key];
          if (el.dataset) el.dataset.i18nDone = '1';
        }
      }
    }

    function translateText(root) {
      var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode: function(node) {
          if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
          var p = node.parentNode;
          if (!p) return NodeFilter.FILTER_REJECT;
          if (p.dataset && p.dataset.i18nDone === '1') return NodeFilter.FILTER_REJECT;
          if (p.closest && p.closest('#tc-lang-switch')) return NodeFilter.FILTER_REJECT;
          var tag = (p.tagName || '').toLowerCase();
          if (tag === 'script' || tag === 'style' || tag === 'noscript') return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        }
      });
      var node;
      while ((node = walker.nextNode())) {
        var key = norm(node.nodeValue);
        if (TEXT[key]) {
          node.nodeValue = TEXT[key];
          if (node.parentNode && node.parentNode.dataset) node.parentNode.dataset.i18nDone = '1';
        }
      }
    }

    function translateAttrs(root) {
      if (!root.querySelectorAll) return;
      var els = root.querySelectorAll('[alt], [title], [aria-label], [placeholder], [value]');
      var attrs = ['alt', 'title', 'aria-label', 'placeholder', 'value'];
      for (var i = 0; i < els.length; i++) {
        for (var j = 0; j < attrs.length; j++) {
          var v = els[i].getAttribute(attrs[j]);
          if (!v) continue;
          var key = norm(v);
          if (TEXT[key]) els[i].setAttribute(attrs[j], TEXT[key]);
        }
      }
    }

    return function(root) {
      if (!root) root = document.body;
      translateHTML(root);
      translateText(root);
      translateAttrs(root);
    };
  }

  // Reset i18nDone flags so a re-run translates from scratch.
  function clearDoneFlags() {
    var els = document.querySelectorAll('[data-i18n-done]');
    for (var i = 0; i < els.length; i++) els[i].removeAttribute('data-i18n-done');
  }

  var currentRun = null;

  function translatePage(locale) {
    var bag = (cfg.dictionary || {})[locale];
    applyDir(locale);
    if (!bag) return; // English / default — no translation needed.
    var run = buildPasses(bag);
    currentRun = run;
    run(document.body);
  }

  // 1. Synchronous initial pass.
  var initial = detectLocaleSync();
  applyDir(initial);

  function bootSwitcher(activeLocale) {
    var sel = document.getElementById('tc-lang-select');
    if (!sel) return;
    sel.value = (supported.indexOf(activeLocale) !== -1) ? activeLocale : (cfg['default'] || 'en');
    sel.addEventListener('change', function() {
      try { localStorage.setItem('tc_lang_v2', sel.value); } catch (e) {}
      var u = new URL(window.location.href);
      u.searchParams.set('lang', sel.value);
      window.location.href = u.toString();
    });
  }

  function start(locale) {
    bootSwitcher(locale);
    translatePage(locale);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function(){ start(initial); });
  } else {
    start(initial);
  }

  // 2. Async geo upgrade — only if user hasn't picked manually
  // and browser language hasn't already matched a non-en locale.
  var hadExplicitChoice = false;
  try {
    var u = new URL(window.location.href);
    if (u.searchParams.get('lang')) hadExplicitChoice = true;
    if (localStorage.getItem('tc_lang_v2')) hadExplicitChoice = true;
  } catch (e) {}

  if (!hadExplicitChoice) {
    detectLocaleByIP().then(function(geoLocale) {
      if (!geoLocale) return;
      if (geoLocale === initial) return;
      // Reset done-flags and re-translate with the geo-detected locale.
      clearDoneFlags();
      var sel = document.getElementById('tc-lang-select');
      if (sel) sel.value = geoLocale;
      translatePage(geoLocale);
    });
  }

  // Catch async-rendered content (tc-scan XHR result, lazy sections).
  var mo = new MutationObserver(function(muts) {
    if (!currentRun) return;
    for (var i = 0; i < muts.length; i++) {
      for (var j = 0; j < muts[i].addedNodes.length; j++) {
        var n = muts[i].addedNodes[j];
        if (n.nodeType === 1) currentRun(n);
      }
    }
  });
  mo.observe(document.body, { childList: true, subtree: true });
})();
</script>
