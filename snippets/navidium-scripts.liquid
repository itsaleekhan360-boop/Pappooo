<!-- Navidium script start -->
<script>
  const nvdShop = 'sprout-organic.myshopify.com';
  const nvdShopCurrency = '{{ shop.money_with_currency_format | strip_html }}';
  const nvdControls = {
    cartCounter: 'cart_counter_class', //cart item count
