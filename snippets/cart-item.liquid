<div class="cart__item" data-key="{{ product.key }}">
  <div class="cart__image">
    {% if product.image != blank %}
      <a href="{{ product.url }}" class="image-wrap">
        {%- render 'image-element',
          img: product,
          alt: product.product.title,
          widths: '180, 360, 540',
          sizes: sizes,
          sizeVariable: sizeVariable,
          fallback: fallback,
        -%}
      </a>
    {% endif %}
  </div>
  <div class="cart__item-details">
    <div class="cart__item-title">
      <a href="{{ product.url }}" class="cart__item-name">
        {{ product.product.title }}
      </a>
      {%- unless product.product.has_only_default_variant -%}
        <div class="cart__item--variants">
          {%- for option in product.options_with_values -%}
            <div><span>{{ option.name }}:</span> {{ option.value }}</div>
          {%- endfor -%}
        </div>
      {%- endunless -%}
      {%- if product.selling_plan_allocation != empty -%}
        <div class="cart__item--variants">
          {{ product.selling_plan_allocation.selling_plan.name }}
        </div>
      {%- endif -%}
      {%- assign property_size = product.properties | size -%}
      {% if property_size > 0 %}
        {% for p in product.properties %}
          {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
          {% unless p.last == blank or first_character_in_key == '_' %}
            <div class="cart__item--properties">
              <span>{{ p.first }}:</span>
              {% if p.last contains '/uploads/' %}
                <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
              {% else %}
                {{ p.last }}
              {% endif %}
            </div>
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% comment %} ============================================================================
        TASK 07: SUBSCRIPTION UPGRADE PROMPT
        Shows only if item is one-time purchase AND the product has subscription options
      ============================================================================ {% endcomment %}
      {%- if product.selling_plan_allocation == blank and product.product.selling_plan_groups.size > 0 -%}
        {%- assign first_plan_id = product.product.selling_plan_groups[0].selling_plans[0].id -%}
        
        {%- capture props_json -%}
          {
            {%- assign p_count = 0 -%}
            {%- for p in product.properties -%}
              {%- unless p.last == blank -%}
                {%- if p_count > 0 -%},{%- endif -%}
                "{{ p.first }}": "{{ p.last }}"
                {%- assign p_count = p_count | plus: 1 -%}
              {%- endunless -%}
            {%- endfor -%}
          }
        {%- endcapture -%}

        <div class="cart-upgrade-prompt-box" style="background: #fffdf6; border: 1px solid #e1b12c; padding: 10px; margin-top: 10px; border-radius: 4px;margin-bottom:20px;">
          <p style="font-size: 13px; color: #222; margin: 0 0 6px 0; line-height: 1.4;">
            Switch to a subscription and save on every order — plus free delivery and full flexibility.
          </p>
          <div class="upgrade-action-holder-{{ product.key | replace: ':', '-' }}">
            <button type="button" 
                    class="task-07-upgrade-btn" 
                    data-line-key="{{ product.key }}"
                    data-variant-id="{{ product.variant_id }}" 
                    data-selling-plan="{{ first_plan_id }}"
                    data-qty="{{ product.quantity }}"
                    data-properties='{{ props_json | strip_newlines | strip }}'
                    style="background: #222; color: #fff; border: none; padding: 5px 10px; font-size: 12px; font-weight: 600; border-radius: 3px; cursor: pointer;">
              Switch to subscription
            </button>
          </div>
        </div>
      {%- endif -%}

      {%- if product.selling_plan_allocation != blank -%}
        <!-- Confirmation microcopy if item is already a subscription -->
        <div style="font-size: 12px; color: #2ed573; font-weight: 600; margin-top: 8px;">
          Updated to subscription
        </div>
      {%- endif -%}
      {% comment %} ============================================================================ {% endcomment %}

    </div>
    <div class="cart__item-sub">
      <div>
        <div class="js-qty__wrapper">
          <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
          <input type="text"
            id="cart_updates_{{ product.key }}"
            name="updates[]"
            class="js-qty__num"
            value="{{ product.quantity }}"
            min="0"
            pattern="[0-9]*"
            data-id="{{ product.key }}">
          <button type="button"
            class="js-qty__adjust js-qty__adjust--minus"
            aria-label="{{ 'cart.general.reduce_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-minus" viewBox="0 0 20 20"><path fill="#444" d="M17.543 11.029H2.1A1.032 1.032 0 0 1 1.071 10c0-.566.463-1.029 1.029-1.029h15.443c.566 0 1.029.463 1.029 1.029 0 .566-.463 1.029-1.029 1.029z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">&minus;</span>
          </button>
          <button type="button"
            class="js-qty__adjust js-qty__adjust--plus"
            aria-label="{{ 'cart.general.increase_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-plus" viewBox="0 0 20 20"><path fill="#444" d="M17.409 8.929h-6.695V2.258c0-.566-.506-1.029-1.071-1.029s-1.071.463-1.071 1.029v6.671H1.967C1.401 8.929.938 9.435.938 10s.463 1.071 1.029 1.071h6.605V17.7c0 .566.506 1.029 1.071 1.029s1.071-.463 1.071-1.029v-6.629h6.695c.566 0 1.029-.506 1.029-1.071s-.463-1.071-1.029-1.071z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">+</span>
          </button>
        </div>

        <div class="cart__remove">
          <a href="{{ routes.cart_change_url }}?id={{ product.key }}&amp;quantity=0" class="text-link">
            {{ 'cart.general.remove' | t }}
          </a>
        </div>
      </div>

      <div class="cart__item-price-col text-right">
        {% if product.original_price != product.final_price %}
          <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
          <small class="cart__price cart__price--strikethrough">
            {{ product.original_price | money }}
          </small>
          <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
          <span class="cart__price cart__discount">
            {{ product.final_price | money }}
          </span >
        {% else %}
          <span class="cart__price">
            {{ product.original_price | money }}
          </span>
        {% endif %}

        {%- if product.line_level_discount_allocations != blank -%}
          {%- for discount_allocation in product.line_level_discount_allocations -%}
            <small class="cart__discount">{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</small>
          {%- endfor -%}
        {%- endif -%}

        {%- if product.unit_price_measurement -%}
          {%- capture unit_price_base_unit -%}
            <span class="unit-price-base">
              {%- if product.unit_price_measurement -%}
                {%- if product.unit_price_measurement.reference_value != 1 -%}
                  {{ product.unit_price_measurement.reference_value }}
                {%- endif -%}
                {{ product.unit_price_measurement.reference_unit }}
              {%- endif -%}
            </span>
          {%- endcapture -%}

          <div class="product__unit-price">{{ product.unit_price | money }}/{{ unit_price_base_unit }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  if (typeof runTask07UpgradeFlow === 'undefined') {
    function runTask07UpgradeFlow() {
      document.querySelectorAll('.task-07-upgrade-btn').forEach(function(btn) {
        if (btn.getAttribute('data-processed') === 'true') return;
        btn.setAttribute('data-processed', 'true');

        btn.addEventListener('click', function(event) {
          event.preventDefault();
          
          const lineKey = this.getAttribute('data-line-key');
          const variantId = this.getAttribute('data-variant-id');
          const planId = this.getAttribute('data-selling-plan');
          const quantity = this.getAttribute('data-qty');
          const actionHolder = this.parentElement;
          
          let parsedProps = {};
          try {
            parsedProps = JSON.parse(this.getAttribute('data-properties') || '{}');
          } catch(e) { console.error("Properties extraction failed", e); }

          this.innerText = "Updating...";
          this.style.opacity = "0.5";

          // Step 1: Remove current one-time variant line item
          fetch(window.Shopify.routes.root + 'cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: lineKey, quantity: 0 })
          })
          .then(res => res.json())
          .then(() => {
            // Step 2: Inject item back into cart assigned to its respective selling plan
            return fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: variantId,
                quantity: quantity,
                selling_plan: planId,
                properties: parsedProps
              })
            });
          })
          .then(response => response.json())
          .then(() => {
            // Step 3: Enforce strict placeholder confirmation text layout
            actionHolder.innerHTML = `<span style="font-size: 12px; color: #2ed573; font-weight: 600;">Updated to subscription</span>`;
            
            // Dispatch dynamic ajax updates so theme updates components smoothly
            document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true }));
            
            // Safe timeout delay fallback to render changes without breaking UI mechanics
            setTimeout(() => { window.location.reload(); }, 400);
          })
          .catch(err => {
            console.error('Ajax transition error:', err);
            window.location.reload();
          });
        });
      });
    }

    document.addEventListener("DOMContentLoaded", runTask07UpgradeFlow);
    document.addEventListener("cart:updated", function() {
      setTimeout(runTask07UpgradeFlow, 400);
    });
  } else {
    runTask07UpgradeFlow();
  }
</script>