_video_ftczV7":{"type":"featured-video","name":"t:sections.featured-video.presets.video.name","settings":{"title":"See Why Coby & Ariela love Our Snack Bars","video_url":"https:\/\/www.youtube.com\/watch?v=vaur0eDsFAI","divider":false}},"text_and_image_JRgnCA":{"type":"text-and-image","custom_css":[".index-section {background: linear-gradient(to bottom, #e1f0ee, #ebf5f4); padding: 80px 0;}"],"settings":{"image":"shopify:\/\/shop_images\/sprout_snack_bars_02.webp","image_mask":"square","image2_mask":"none","subtitle":"","title":"Perfect for Kids (and Parents)","text":"<p>Not only do our snack bars come in three delicious flavours that your child will love, but they’re also mess-free. Their soft and chewy texture means no crumbs all over the back seat, so we’re sure you’ll love them too!<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"50","layout":"right","divider":false,"top_padding":true,"bottom_padding":false,"lazyload_images":true}},"text_and_image_JYHQKk":{"type":"text-and-image","custom_css":[".index-section {background: linear-gradient(to bottom, #ebf5f4, #f5faf9); padding: 80px 0;}"],"settings":{"image":"shopify:\/\/shop_images\/sprout_snack_bars.svg","image_mask":"square","image2_mask":"none","subtitle":"","title":"Highly Nutritious to Support Happy, Healthy Kids","text":"<p>Sprout snack bars are made from 100% natural, wholefood ingredients and cold pressed to maintain the nutritional integrity of the ingredients. Entirely plant-based and easy to digest, each flavour is packed with superfoods to provide optimal nourishment alongside a healthy and balanced diet to help your little one grow up strong, happy and healthy.<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"33","layout":"left","divider":false,"top_padding":false,"bottom_padding":false,"lazyload_images":true}},"text_and_image_MPi6cD":{"type":"text-and-image","custom_css":[".index-section {background: linear-gradient(to bottom, #f5faf9, #ffffff); padding: 80px 0;}"],"settings":{"image":"shopify:\/\/shop_images\/sprout_snack_bars_03.webp","image_mask":"none","image2_mask":"none","subtitle":"","title":"Intolerance-Friendly for All Children to Enjoy","text":"<p>We believe all children should have access to nourishing, wholesome food, so we’ve made our bars intolerance-friendly. Suitable for most children from one year old, the Sprout snack bars are free from common ingredients such as dairy, soy, egg and gluten and are an ideal solution for parents with children who are prone to digestive sensitivities.<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"50","layout":"right","divider":false,"top_padding":false,"bottom_padding":false,"lazyload_images":true}},"blocks_TMDrCt":{"type":"_blocks","blocks":{"ai_gen_block_e86d5cc_8giFEp":{"type":"ai_gen_block_e86d5cc","settings":{"desktop_height":80,"mobile_height":60},"blocks":{}}},"block_order":["ai_gen_block_e86d5cc_8giFEp"],"name":"Spacer","settings":{}},"text_and_image_G3wf9e":{"type":"text-and-image","custom_css":[],"settings":{"image":"shopify:\/\/shop_images\/sprout_australia_map_globe.svg","image_mask":"square","image2_mask":"none","subtitle":"","title":"Where It’s Made","text":"<p>Sprout Organic is proudly Australian made and owned. Our Infant Formula range is manufactured to rigorous GMP standards.<br\/><br\/>Along with sourcing and manufacturing as much as possible from local Australian farmers and suppliers, Sprout Organic is certified Australian Owned, supporting investment and job growth in Australia.<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"33","layout":"left","divider":false,"top_padding":false,"bottom_padding":false,"lazyload_images":true}},"text_columns_zbiNDQ":{"type":"text-columns","blocks":{"text_block_TPB4GA":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/heart_smile_24dp_FFFFFF_FILL0_wght200_GRAD0_opsz24_1.svg","image_mask":"none","image_width":60,"title":"Healthy","text":"<p>Plant-based nutrition easily provides infants and children with all the energy and nutrients they need to grow and thrive. Current research shows that children who are raised on healthful plant-based diets also have a reduced risk of heart disease, cancer, obesity and diabetes.<\/p>","button_label":"","button_link":""}},"text_block_P7hafp":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/eco_24dp_FFFFFF_FILL0_wght200_GRAD0_opsz24_1.svg","image_mask":"none","image_width":60,"title":"Sustainable","text":"<p>Our choices matter. Right now, we’re consuming resources at a far greater rate than can be restored. Plant-based nutrition offers a dramatically lower carbon, water, and ecological footprint, making it the best choice to ensure a sustainable future for our kids.<\/p>","button_label":"","button_link":""}},"text_block_chPhMf":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/diversity_2_24dp_FFFFFF_FILL0_wght200_GRAD0_opsz24.svg","image_mask":"none","image_width":60,"title":"Inclusive","text":"<p>At Sprout, inclusivity is a founding pillar of who we are. Food brings us together, and we believe that one of the best ways to foster inclusivity is to create nutrient-rich foods for kids which are free from ingredients that cause 90% of all allergic reactions (eggs, fish, milk, peanuts, shellfish, soy and wheat). Our products are also certified vegan and Kosher friendly, making them a convenient choice for all kids to enjoy!<\/p>","button_label":"","button_link":""}}},"block_order":["text_block_TPB4GA","text_block_P7hafp","text_block_chPhMf"],"custom_css":[".index-section {background: linear-gradient(to bottom, #9bccc7, #ffffff); padding: 80px 0;}"],"settings":{"title":"Why Plant-Based Nutrition for Kids?","align_text":"center","divider":false}},"product-recommendations":{"type":"product-recommendations","settings":{"product_recommendations_heading":"You may also like","related_count":6,"products_per_row":5}},"recently-viewed":{"type":"recently-viewed","disabled":true,"settings":{"recent_count":5}},"collection-return":{"type":"collection-return","settings":{}}},"order":["main","blocks_YabNFb","countdown_bTtriE","sub","rich_text_RMidiT","1719801934d6054884","featured_video_ftczV7","text_and_image_JRgnCA","text_and_image_JYHQKk","text_and_image_MPi6cD","blocks_TMDrCt","text_and_image_G3wf9e","text_columns_zbiNDQ","product-recommendations","recently-viewed","collection-return"]}