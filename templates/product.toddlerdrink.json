gs":{"review_data":"sample_data","max_width":1200,"show_shop_reviews":false,"empty_state":"empty_widget"}}},"block_order":["judge_me_reviews_review_widget_3jMKqw"],"settings":{"full_width":false,"space_around":true}},"blocks_TFGcze":{"type":"_blocks","blocks":{"ai_gen_block_e86d5cc_nNHViH":{"type":"ai_gen_block_e86d5cc","name":"Spacer","settings":{"desktop_height":0,"mobile_height":30},"blocks":{}},"ai_gen_block_eb32af0_dejmgp":{"type":"ai_gen_block_eb32af0","settings":{"heading":"","heading_size":32,"header_spacing":40,"logo_1":"shopify://shop_images/02_sxc.svg","logo_2":"shopify://shop_images/03_vegan_certified.svg","logo_3":"shopify://shop_images/04_halal.svg","logo_4":"shopify://shop_images/05_fsanz_compliant.svg","logo_5":"shopify://shop_images/06_inc_member.svg","logo_6":"shopify://shop_images/07_australian_owned_certified.svg","logo_7":"shopify://shop_images/01_climate_active.svg","logo_height":80,"logo_spacing":60,"grayscale_amount":0,"logo_opacity":0.8,"scroll_speed":30,"desktop_width_percent":100,"background_color":"#e1f0ee","section_padding":0},"blocks":{}}},"block_order":["ai_gen_block_e86d5cc_nNHViH","ai_gen_block_eb32af0_dejmgp"],"custom_css":["{background-color: #e1f0ee; padding-top: 80px;}"],"name":"Logo carousel","settings":{}},"text_and_image_nAbKqj":{"type":"text-and-image","custom_css":[".index-section {background: linear-gradient(to bottom, #e1f0ee, #ebf5f4); padding: 80px 0;}"],"settings":{"image":"shopify://shop_images/SproutOrganic_Summer-35.webp","image_mask":"square","image2_mask":"none","subtitle":"","title":"Testing & Safety Assurance","text":"<p>Sprout Organic has undertaken the required testing and certification requirements to ensure the efficacy and safety of our products. Australia and New Zealand have the highest standards worldwide in regard to infant formulas and children’s products. For this reason, Australian infant formulas are some of the most sought after throughout the world. Sprout Organic’s infant formula meets the required FSANZ standards and has been verified to this by one of the largest food legal groups in Australia. We are also members of the Australian Infant Nutrition Council and signatories to the MAIF agreement, all of which require a strict safety eligibility of our products.</p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"50","layout":"right","divider":false,"top_padding":false,"bottom_padding":false,"lazyload_images":true}},"text_and_image_fJfFKE":{"type":"text-and-image","custom_css":[".index-section {background: linear-gradient(to bottom, #ebf5f4, #f5faf9); padding: 80px 0;}"],"settings":{"image":"shopify://shop_images/sprout_field_to_formula_organic_rice_starch.webp","image_mask":"square","image2_mask":"none","subtitle":"","title":"Beyond Soy: A Safer Plant-Based Choice","text":"<p>Sprout Organic is the world’s first 100% plant-based, organic, and vegan certified infant formula available for retail in Australia, but we are by no means the first plant-based formula. There are several soy-based offerings which exist in the market, however soy is also a common allergen and not recommended for infants under six months of age.</p><p><strong>We use rice starch as the base ingredient for our formulas which is safe for infants to consume from birth.</strong> While the use of rice starch is uncommon in the southern hemisphere, it is very common in Europe and has represented a significant portion of its infant formula market for decades.</p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"50","layout":"left","divider":false,"top_padding":false,"bottom_padding":false,"lazyload_images":true}},"text_and_image_x6kXGR":{"type":"text-and-image","custom_css":[".index-section {background: linear-gradient(to bottom, #f5faf9, #ffffff); padding: 80px 0;}"],"settings":{"image":"shopify://shop_images/sprout_australia_map_globe.svg","image_mask":"square","image2_mask":"none","subtitle":"","title":"Where It’s Made","text":"<p>Sprout Organic is proudly Australian made and owned. Our Infant Formula range is manufactured to rigorous GMP standards.<br/><br/>Along with sourcing and manufacturing as much as possible from local Australian farmers and suppliers, Sprout Organic is certified Australian Owned, supporting investment and job growth in Australia.</p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"33","layout":"right","divider":false,"top_padding":false,"bottom_padding":false,"lazyload_images":true}},"blocks_8ihAam":{"type":"_blocks","blocks":{"ai_gen_block_e86d5cc_TXaxiz":{"type":"ai_gen_block_e86d5cc","settings":{"desktop_height":80,"mobile_height":60},"blocks":{}}},"block_order":["ai_gen_block_e86d5cc_TXaxiz"],"name":"Spacer","settings":{}},"text_and_image_RJ4LTj":{"type":"text-and-image","custom_css":[],"settings":{"image":"shopify://shop_images/sprout_our_process.webp","image_mask":"square","image2_mask":"none","subtitle":"","title":"Our Process","text":"<p>From the earliest concept stage of our products, we work shoulder to shoulder with food technologists, biotechnologists, and food scientists to bring our ideas to life. We tweak and resample, tweak and resample, until we’re 100% satisfied with the result. We then move our products through a critical review process conducted by paediatricians, nutritionists and of course, real mums and families to see if there’s anything we could possibly do to make them better. The result? Healthy, wholesome, and delicious plant-based products you can trust to provide the best foundation for your little one’s health.</p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","image_width":"50","layout":"left","divider":false,"top_padding":false,"bottom_padding":false,"lazyload_images":true}},"text_columns_zMTpeW":{"type":"text-columns","blocks":{"text_block_WeNWM3":{"type":"text_block","settings":{"enable_image":true,"image":"shopify://shop_images/heart_smile_24dp_FFFFFF_FILL0_wght200_GRAD0_opsz24_1.svg","image_mask":"none","image_width":60,"title":"Healthy","text":"<p>Plant-based nutrition easily provides infants and children with all the energy and nutrients they need to grow and thrive. Current research shows that children who are raised on healthful plant-based diets also have a reduced risk of heart disease, cancer, obesity and diabetes.</p>","button_label":"","button_link":""}},"text_block_WFTwXx":{"type":"text_block","settings":{"enable_image":true,"image":"shopify://shop_images/eco_24dp_FFFFFF_FILL0_wght200_GRAD0_opsz24_1.svg","image_mask":"none","image_width":60,"title":"Sustainable","text":"<p>Our choices matter. Right now, we’re consuming resources at a far greater rate than can be restored. Plant-based nutrition offers a dramatically lower carbon, water, and ecological footprint, making it the best choice to ensure a sustainable future for our kids.</p>","button_label":"","button_link":""}},"text_block_eRgCH8":{"type":"text_block","settings":{"enable_image":true,"image":"shopify://shop_images/diversity_2_24dp_FFFFFF_FILL0_wght200_GRAD0_opsz24.svg","image_mask":"none","image_width":60,"title":"Inclusive","text":"<p>At Sprout, inclusivity is a founding pillar of who we are. Food brings us together, and we believe that one of the best ways to foster inclusivity is to create nutrient-rich foods for kids which are free from ingredients that cause 90% of all allergic reactions (eggs, fish, milk, peanuts, shellfish, soy and wheat). Our products are also certified vegan and Kosher friendly, making them a convenient choice for all kids to enjoy!</p>","button_label":"","button_link":""}}},"block_order":["text_block_WeNWM3","text_block_WFTwXx","text_block_eRgCH8"],"custom_css":[".index-section {background: linear-gradient(to bottom, #9bccc7, #ffffff); padding: 80px 0;}"],"settings":{"title":"Why Plant-Based Nutrition for Kids?","align_text":"center","divider":false}},"product-recommendations":{"type":"product-recommendations","settings":{"product_recommendations_heading":"You May Also like","related_count":6,"products_per_row":5}},"recently-viewed":{"type":"recently-viewed","disabled":true,"settings":{"recent_count":5}},"collection-return":{"type":"collection-return","settings":{}}},"order":["main","blocks_dyr4Uw","sub","countdown_GmEBwp","rich_text_XbATWL","17466819165b4267ac","blocks_TFGcze","text_and_image_nAbKqj","text_and_image_fJfFKE","text_and_image_x6kXGR","blocks_8ihAam","text_and_image_RJ4LTj","text_columns_zMTpeW","product-recommendations","recently-viewed","collection-return"]}